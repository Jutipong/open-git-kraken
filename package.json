{
    "name": "open-git-kraken",
    "version": "0.1.0",
    "description": "Open-source Git GUI inspired by GitKraken — free, no forced updates, no licensing",
    "license": "MIT",
    "author": "js.dev",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "build:win": "electron-vite build && electron-builder --win",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
        "type-check": "pnpm typecheck",
        "format": "oxfmt --write --ignore-path .oxfmtignore",
        "lint": "oxlint . && pnpm typecheck",
        "lint:fix": "oxlint --fix .",
        "start": "electron-vite preview"
    },
    "dependencies": {
        "@gitgraph/js": "^1.4.0",
        "@vueuse/core": "^12.3.0",
        "pinia": "^2.3.0",
        "simple-git": "^3.27.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.31",
        "@types/node": "^22.10.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^3.1.0",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "sass": "^1.83.0",
        "typescript": "^5.7.2",
        "unocss": "^66.7.5",
        "unplugin-auto-import": "^19.0.0",
        "unplugin-vue-components": "^28.0.0",
        "unplugin-vue-router": "^0.10.9",
        "vite": "^6.0.0",
        "vue-tsc": "^2.2.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild",
            "vue-demi",
            "@parcel/watcher"
        ]
    }
}
